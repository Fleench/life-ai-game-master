<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameMaster.App.ViewModels"
             x:Class="GameMaster.App.Views.AppHubView"
             x:DataType="vm:AppHubViewModel">
    
    <ScrollViewer Margin="10">
        <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{Binding Platform}" />
                            <TextBlock Text="{Binding RegisteredAt, StringFormat='Registered: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
