<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameMaster.App.ViewModels"
             x:Class="GameMaster.App.Views.PendingPermissionsView"
             x:DataType="vm:PendingPermissionsViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10,10,10,5">
            <TextBlock Text="🔔 Pending Permission Requests" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding LoadPendingCommand}" Padding="8,4" />
        </StackPanel>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" 
                   Text="No pending permission requests."
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding !HasPendingRequests}" />

        <!-- Requests list -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasPendingRequests}" Margin="10">
            <ItemsControl ItemsSource="{Binding PendingRequests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingPermission">
                        <Border BorderBrush="#FFC107" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding DisplayText}" 
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1"
                                        Content="Approve"
                                        Command="{Binding $parent[UserControl].DataContext.(vm:PendingPermissionsViewModel.ApproveCommand)}"
                                        CommandParameter="{Binding}"
                                        Background="#34C759"
                                        Foreground="White"
                                        CornerRadius="6"
                                        Margin="8,0,4,0"
                                        Padding="10,4" />
                                <Button Grid.Column="2"
                                        Content="Deny"
                                        Command="{Binding $parent[UserControl].DataContext.(vm:PendingPermissionsViewModel.DenyCommand)}"
                                        CommandParameter="{Binding}"
                                        Background="#FF3B30"
                                        Foreground="White"
                                        CornerRadius="6"
                                        Padding="10,4" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
