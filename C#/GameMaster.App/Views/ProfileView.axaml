<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameMaster.App.ViewModels"
             x:Class="GameMaster.App.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <Grid Background="#0f172a" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer>
            <Border Background="#1e293b" CornerRadius="20" Padding="24"
                    BorderBrush="#334155" BorderThickness="1"
                    MaxWidth="400" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.BoxShadow>
                    <BoxShadows>0 10 25 -5 #66000000, 0 8 10 -6 #66000000</BoxShadows>
                </Border.BoxShadow>
                <StackPanel Spacing="20">
                    
                    <!-- Header -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <!-- Avatar -->
                        <Border Width="90" Height="90" CornerRadius="45" Background="#4f46e5"
                                BorderBrush="#26ffffff" BorderThickness="3" HorizontalAlignment="Center">
                            <TextBlock Text="🧙‍♂️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border.BoxShadow>
                                <BoxShadows>0 4 12 0 #33000000</BoxShadows>
                            </Border.BoxShadow>
                        </Border>
                        
                        <!-- Username -->
                        <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Center" LetterSpacing="0.02"/>

                        <!-- Global Progression -->
                        <Border Background="#33000000" CornerRadius="12" Padding="12" BorderBrush="#0cffffff" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="{Binding LifeLevel, StringFormat='Level {0}'}" FontWeight="Bold" FontSize="16" Foreground="#a5b4fc" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                
                                <ProgressBar Value="{Binding LifeProgress}" Maximum="100" Height="14" Foreground="#6366f1" Background="#334155" CornerRadius="7" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Stats List -->
                    <StackPanel Spacing="14">
                        <!-- Physical -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="💪" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PhysicalLevel, StringFormat='Lv. {0} Physical'}" FontWeight="SemiBold" FontSize="14" Foreground="#f8fafc" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PhysicalExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding PhysicalProgress}" Maximum="100" Height="10" Foreground="#6366f1" Background="#334155" CornerRadius="5" />
                        </StackPanel>

                        <!-- Mental -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🧠" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MentalLevel, StringFormat='Lv. {0} Mental'}" FontWeight="SemiBold" FontSize="14" Foreground="#f8fafc" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding MentalExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding MentalProgress}" Maximum="100" Height="10" Foreground="#6366f1" Background="#334155" CornerRadius="5" />
                        </StackPanel>

                        <!-- Emotional -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="❤️" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EmotionalLevel, StringFormat='Lv. {0} Emotional'}" FontWeight="SemiBold" FontSize="14" Foreground="#f8fafc" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding EmotionalExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding EmotionalProgress}" Maximum="100" Height="10" Foreground="#6366f1" Background="#334155" CornerRadius="5" />
                        </StackPanel>

                        <!-- Social -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🤝" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SocialLevel, StringFormat='Lv. {0} Social'}" FontWeight="SemiBold" FontSize="14" Foreground="#f8fafc" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SocialExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding SocialProgress}" Maximum="100" Height="10" Foreground="#6366f1" Background="#334155" CornerRadius="5" />
                        </StackPanel>

                        <!-- Spiritual -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✨" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SpiritualLevel, StringFormat='Lv. {0} Spiritual'}" FontWeight="SemiBold" FontSize="14" Foreground="#f8fafc" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SpiritualExp, StringFormat='{}{0:N0} XP'}" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding SpiritualProgress}" Maximum="100" Height="10" Foreground="#6366f1" Background="#334155" CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer -->
                    <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="🪙" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CoinsBalance, StringFormat='{}{0:N0} Gold'}" FontWeight="SemiBold" FontSize="15" Foreground="#f59e0b" VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="🎒" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InventoryCount, StringFormat='{}{0} Items'}" FontWeight="SemiBold" FontSize="15" Foreground="#10b981" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
